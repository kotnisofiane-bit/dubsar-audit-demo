# FIXTURE FILE — NOT A REAL CREDENTIAL FILE.
#
# This exists so a DUBSAR audit can find a committed environment file and report
# it. The values below are placeholders and grant access to nothing. DUBSAR never
# opens this file: the scanner flags a sensitive path by NAME and skips it, so
# the audit's finding is "an environment file is committed", never its contents.

DATABASE_URL=postgres://placeholder:placeholder@localhost:5432/placeholder
API_TOKEN=placeholder-not-a-real-token
